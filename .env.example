# Copy to .env (gitignored) and chmod 600.
# Fill every value. The script sources this file. Tracked files ship none of it.

TELEGRAM_BOT_TOKEN=
# Channel destination (preferred for multiple people):
#   1. Create a Telegram channel
#   2. Add this bot as administrator with Post messages
#   3. Public channel: @your_channel  (must NOT end in "bot")
#      Private channel: -100xxxxxxxxxx
# Multiple destinations: comma-separated
TELEGRAM_CHAT_ID=@your_channel
TARGET_HOST=
WATCH_NAME=target
TZ=UTC
PING_COUNT=3
PING_WAIT=2
FAIL_THRESHOLD=3
REMIND_SECS=3600
STATE_DIR=${HOME}/.cache/ping-peer-alerter
