# Copy to .env (gitignored) and chmod 600.
# Fill every value. Tracked files ship no addresses or credentials.
# Do not put a GitHub PAT in this file on a machine that runs the watcher
# under cron unless you must; the script unsets github_pat after sourcing.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TARGET_HOST=
WATCH_NAME=target
TZ=UTC
